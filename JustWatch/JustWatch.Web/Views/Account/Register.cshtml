@{
     Layout = null;
     ViewData["Title"] = "LogIn";
     ViewData["BodyClass"] = "back-register";
}
@model RegisterViewModel

<!DOCTYPE html>
<html lang="en">
<html lang="en" class="@ViewData["BodyClass"]">
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>@ViewData["Title"] - JustWatch</title>

     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
     <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="register-page">
     <div class="login-overlay">
          <a asp-controller="Home" asp-action="Start" class="jw-logo login-logo">
               <span class="jw-just">JUST</span>
               <span class="jw-watch">WATCH</span>
          </a>
          <div class="login-box">
               <h1>Register</h1>
               <form asp-action="Register" asp-controller="Account" method="post" class="login-form">
                   @Html.AntiForgeryToken()

                    <div class="name-row">
                         <input asp-for="FirstName" class="login-input" placeholder="First Name"/>
                         <input asp-for="LastName" class="login-input" placeholder="Last Name"/>
                    </div>

                    <input asp-for="Email" class="login-input" placeholder="Email"/>

                    <input asp-for="Password" class="login-input" placeholder="Password"/>

                    <input asp-for="ConfirmPassword" class="login-input" placeholder="Confirm password"/>

                    <button type="submit" class="login-btn">Register</button>

                    <p class="login-text">
                         Already have an account?
                         <a asp-controller="Account" asp-action="LogIn">Sign in</a>
                    </p>
               </form>
          </div>
     </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
