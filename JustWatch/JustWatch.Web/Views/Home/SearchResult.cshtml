
@{
    ViewData["Title"] = "SearchResult";
    ViewData["BodyClass"] = "back-start";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<JustWatch.Web.Models.Commom.SearchContentViewModel>

<div class="container">
    @if(Model.Count == 0)
    {
        <h3>No results found.</h3>
    }
    else
    {
        <h3>Found @Model.Count results.</h3>
        <div class="movies-grid">
            @foreach (var movie in Model)
            {
                <div class="movie-card">
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">
                        <div class="movie-poster">
                            <img src="@movie.PosterURL" alt="@movie.Title poster" />
                        </div>
                        <div class="movie-title">@movie.Title</div>
                    </a>
                    <div class="movie-year">@movie.Info@(movie.Type == "TVShow" ? " Seasons" : "")</div>
                </div>
            }
        </div>
    }
</div>

