@{
     Layout = null;
     ViewData["Title"] = "LogIn";
     ViewData["BodyClass"] = "back-login";
}

@model LoginViewModel

<!DOCTYPE html>
<html lang="en">
<html lang="en" class="@ViewData["BodyClass"]">
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>@ViewData["Title"] - JustWatch</title>

     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
     <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
     <div class="login-overlay">
          <a asp-controller="Home" asp-action="Start" class="jw-logo login-logo">
               <span class="jw-just">JUST</span>
               <span class="jw-watch">WATCH</span>
          </a>
          <div class="login-box">
               <h1>Log In</h1>
               <form asp-action="LogIn" asp-controller="Account" method="post" class="login-form">
                   @Html.AntiForgeryToken()

                    <input asp-for="Email" class="login-input" placeholder="Email" />

                    <input asp-for="Password" class="login-input" placeholder="Password" />

                    <button type="submit" class="login-btn">Log in</button>

                    <p class="login-text">
                         Don't have an account?
                         <a asp-controller="Account" asp-action="Register">Register</a>
                    </p>
               </form>
          </div>
     </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
