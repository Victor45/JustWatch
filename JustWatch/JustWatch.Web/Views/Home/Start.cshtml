@{
    ViewData["Title"] = "Start";
    ViewData["BodyClass"] = "back-start";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model JustWatch.Web.Models.Commom.HomeViewModel

<div class="container start-page-container">
    <h1 class="title-start">
        <a asp-controller="Movies" asp-action="Index">
            Movies <i class="bi bi-chevron-right"></i>
        </a>
    </h1>
    <div class="movies-grid">
        @foreach (var movie in Model.Movies)
        {
            <div class="movie-card">
                <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">
                    <div class="movie-poster">
                        <img src="@movie.PosterUrl" alt="@movie.Title poster" />
                    </div>
                    <div class="movie-title">@movie.Title</div>
                </a>
                <div class="movie-year">@movie.Year</div>
            </div>
        }
    </div>
    <h1 class="title-start">
        <a asp-controller="TVShows" asp-action="Index">
            TV Shows <i class="bi bi-chevron-right"></i>
        </a>
    </h1>
    <div class="movies-grid">
        @foreach (var tvshow in Model.TVShows)
        {
            <div class="movie-card">
                <a asp-controller="TVShows" asp-action="Details" asp-route-id="@tvshow.Id">
                    <div class="movie-poster">
                        <img src="@tvshow.PosterUrl" alt="@tvshow.Title poster" />
                    </div>
                    <div class="movie-title">@tvshow.Title</div>
                </a>
                <div class="movie-year">@tvshow.Seasons Seasons</div>
            </div>
        }
    </div>
</div>